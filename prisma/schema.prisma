generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  CLIENT
  DRIVER
  ADMIN
  CUSTOMER_SUPPORT
}

enum DriverStatus {
  OFFLINE
  ONLINE
  ON_TRIP
  SUSPENDED
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED

  CLIENT_CANCELLED
  DRIVER_CANCELLED

  NO_DRIVER_FOUND
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum RideMode {
  PRIVATE
  CARPOOLING
}

enum RideFlow {
  NORMAL
  NEGOTIATION
}

enum ServiceType {
  STANDARD
  VIP
  VAN
}

enum TransactionType {
  COMMISSION
  PAYOUT
  ADJUSTMENT
  TIP
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────

model User {
  id         Int     @id @default(autoincrement())
  phone      String? @unique
  email      String? @unique

  role       Role    @default(CLIENT)
  isVerified Boolean @default(false)

  name         String?
  avatarUrl    String?
  passwordHash String?

  driver Driver?

  rides             Ride[] @relation("ClientRides")
  reviews           Review[] @relation("ClientReviews")
  tickets           SupportTicket[]
  notifications     Notification[]
  favoriteLocations FavoriteLocation[]
  couponUsages      CouponUsage[]

  carpoolPassengers RidePassenger[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([phone])
  @@index([email])
}

// ─────────────────────────────────────────────
// DRIVER
// ─────────────────────────────────────────────

model Driver {
  id     Int  @id @default(autoincrement())
  userId Int  @unique

  user User @relation(fields: [userId], references: [id])

  licenseNumber String
  carModel      String
  carPlate      String @unique

  carColor String?
  carYear  Int?

  commissionRate Decimal @default(0.20)

  isApproved Boolean      @default(false)
  status     DriverStatus @default(OFFLINE)

  latitude           Float?
  longitude          Float?
  lastLocationUpdate DateTime?

  rating     Float @default(0)
  totalRides Int   @default(0)

  wallet DriverWallet?

  rides   Ride[]
  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([status])
}

// ─────────────────────────────────────────────
// RIDE
// ─────────────────────────────────────────────

model Ride {
  id       Int  @id @default(autoincrement())
  clientId Int
  driverId Int?

  client User @relation("ClientRides", fields: [clientId], references: [id])
  driver Driver? @relation(fields: [driverId], references: [id])

  // State
  status      RideStatus  @default(REQUESTED)
  rideFlow    RideFlow    @default(NORMAL)
  rideMode    RideMode    @default(PRIVATE)
  serviceType ServiceType @default(STANDARD)

  // Carpooling
  maxPassengers  Int @default(1)
  availableSeats Int @default(1)

  passengers RidePassenger[]

  // Pricing
  systemFare     Decimal?
  clientOffer    Decimal?
  negotiatedFare Decimal?

  discountAmount Decimal? @default(0)
  finalFare      Decimal?
  tip            Decimal? @default(0)
  tipSubmittedAt DateTime?

  offerExpiresAt DateTime?

  // Location
  pickupLat      Float
  pickupLng      Float
  pickupAddress  String?

  dropoffLat      Float
  dropoffLng      Float
  dropoffAddress  String?

  // Metrics
  distance Float?
  duration Int?

  // Time tracking
  requestedAt DateTime @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  cancelReason String?

  // Relations
  payment Payment?
  review  Review?

  couponUsage CouponUsage?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([clientId])
  @@index([driverId])
  @@index([status])
}

// ─────────────────────────────────────────────
// PAYMENT
// ─────────────────────────────────────────────

model Payment {
  id Int @id @default(autoincrement())

  rideId Int @unique
  ride   Ride @relation(fields: [rideId], references: [id])

  amount Decimal

  method PaymentMethod @default(CASH)
  status PaymentStatus @default(PENDING)

  transactionId String?

  collectedByDriver Boolean  @default(false)
  collectedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────
// REVIEW
// ─────────────────────────────────────────────

model Review {
  id Int @id @default(autoincrement())

  rideId   Int @unique
  clientId Int
  driverId Int

  ride   Ride   @relation(fields: [rideId], references: [id])
  client User   @relation("ClientReviews", fields: [clientId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  rating Int
  comment String?

  createdAt DateTime @default(now())

  @@index([driverId])
}

// ─────────────────────────────────────────────
// DRIVER WALLET
// ─────────────────────────────────────────────

model DriverWallet {
  id Int @id @default(autoincrement())

  driverId Int @unique
  driver   Driver @relation(fields: [driverId], references: [id])

  balance       Decimal @default(0)
  totalEarned   Decimal @default(0)
  totalDeducted Decimal @default(0)

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id Int @id @default(autoincrement())

  walletId Int
  wallet   DriverWallet @relation(fields: [walletId], references: [id])

  amount Decimal

  type TransactionType

  description String?
  rideId      Int?

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([rideId])
}

// ─────────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────────

model Coupon {
  id   Int    @id @default(autoincrement())
  code String @unique

  discountType  DiscountType
  discountValue Decimal
  maxDiscount   Decimal?

  minFare Decimal?

  usageLimit   Int?
  usageCount   Int @default(0)
  perUserLimit Int @default(1)

  startsAt DateTime?
  expiresAt DateTime?

  isActive Boolean @default(true)

  newUsersOnly Boolean @default(false)

  usages CouponUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model CouponUsage {
  id Int @id @default(autoincrement())

  couponId Int
  userId   Int
  rideId   Int @unique

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  ride   Ride   @relation(fields: [rideId], references: [id])

  discountApplied Decimal

  usedAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// SUPPORT
// ─────────────────────────────────────────────

model SupportTicket {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  subject String
  message String

  isResolved Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────
// CARPOOL PASSENGERS
// ─────────────────────────────────────────────

model RidePassenger {
  id Int @id @default(autoincrement())

  rideId   Int
  clientId Int

  ride   Ride @relation(fields: [rideId], references: [id])
  client User @relation(fields: [clientId], references: [id])

  pickupLat      Float
  pickupLng      Float
  pickupAddress  String?

  dropoffLat      Float
  dropoffLng      Float
  dropoffAddress  String?

  fare Decimal?

  joinedAt DateTime @default(now())

  @@unique([rideId, clientId])

  @@index([rideId])
  @@index([clientId])
}

// ─────────────────────────────────────────────
// OTP
// ─────────────────────────────────────────────

model OtpCode {
  id Int @id @default(autoincrement())

  phone String?
  email String?

  code String

  expiresAt DateTime

  used     Boolean @default(false)
  attempts Int     @default(0)

  purpose String?

  createdAt DateTime @default(now())

  @@index([email, used, expiresAt])
  @@index([phone, used, expiresAt])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  title   String
  message String

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ─────────────────────────────────────────────
// FAVORITE LOCATIONS
// ─────────────────────────────────────────────

model FavoriteLocation {
  id Int @id @default(autoincrement())

  userId Int
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String

  address String?

  latitude  Float
  longitude Float

  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// DEPARTMENTS
// ─────────────────────────────────────────────

model Department {
  id   Int    @id @default(autoincrement())
  name String @unique

  description String?

  icon     String?
  isActive Boolean @default(true)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}